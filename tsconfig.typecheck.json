{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "vite.config.js",
    "playwright.config.js",
    "vitest.config.js"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "backups",
    "test-results"
  ]
}
